   "input": {
    "script": "const rows = [...document.querySelectorAll('.infobox tr')].map(r => r.textContent.replace(/\\s+/g, ' ').trim());\nconst i = rows.findIndex(r => /^Record height/i.test(r));\nconst j = rows.findIndex(r => /^Height$/i.test(r));\nconst paras = [...document.querySelectorAll('#mw-content-text p')].map(p => p.textContent.replace(/\\s+/g, ' ').trim()).filter(t => /\\btall\\b|metres/i.test(t)).slice(0, 3);\nreturn JSON.stringify({ record: rows.slice(i, i + 4), height: rows.slice(j, j + 6), paras }, null, 2);"
